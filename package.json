{
  "name": "bomwise",
  "version": "1.0.0",
  "description": "BOMWise - Intelligent BOM optimizer for LCEDA Pro. Analyze BOM with one click, smart alternative parts recommendation, real-time inventory & price check.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "lceda",
    "eda",
    "bom",
    "extension",
    "electronics"
  ],
  "author": "BOMWise Contributors",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/src/__tests__/**/*.test.ts"],
    "moduleNameMapper": {
      "^(.*)\\.js$": "$1"
    }
  }
}
